<!DOCTYPE html>
<html lang="zxx">
<meta http-equiv="content-type" content="text/html;charset=UTF-8" />
<head>
    <title>Score Tab</title>
    <meta charset="utf-8">
    <meta content="width=device-width, initial-scale=1.0" name="viewport">
    <meta name="description" content="">
    <meta name="keywords" content="">
    <meta name="author" content="">
    <meta name="MobileOptimized" content="320">
    <!--Start Style -->
    <link rel="stylesheet" type="text/css" href="/css/fonts.css">
    <link rel="stylesheet" type="text/css" href="/css/datatables.css">
    <link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css">
    <link rel="stylesheet" type="text/css" href="/css/font-awesome.min.css">
    <link rel="stylesheet" type="text/css" href="/css/icofont.min.css">
    <link rel="stylesheet" href="/css/swiper.min.css">
    <!--Page Specific -->
    <link rel="stylesheet" type="text/css" href="/css/nice-select.css">
    <!--Custom Style -->
    <link rel="stylesheet" type="text/css" href="/css/style.css">
    <link rel="stylesheet" id="theme-change" type="text/css" href="#">
    <!-- Favicon Link -->
    <link rel="shortcut icon" type="image/png" href="/images/favicon.png">
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/api.js"></script>
</head>
<body>
    <div class="loader">
        <div class="spinner">
            <img src="/images/loader.gif" alt="" />
        </div>
    </div>
    <!-- Main Body -->
    <div class="page-wrapper">
        <!-- Header Start -->
        <header class="header-wrapper main-header">
            <div class="header-inner-wrapper">
                <div class="header-right">
                    <div class="header-left">
                        <div class="header-links">
                            <a href="index.html" class="admin-logo">
                                <img src="/logo.svg" alt="" class="sp_logo w-100 ">
                                <img src="/logo.svg" alt="" class="sp_mini_logo w-100">
                            </a>
                        </div>
                    </div>
                    <div class="header-controls">
                        <div class="user-info-wrapper header-links">
                            <a href="javascript:void(0);" class="user-info">
                                <img src="/images/user.jpg" alt="" class="user-img">
                                <div class="blink-animation">
                                    <span class="blink-circle"></span>
                                    <span class="main-circle"></span>
                                </div>
                            </a>
                            <div class="user-info-box">
                                <div class="drop-down-header">
                                    <h4>John Brown</h4>
                                    <p>UI | UX Designer</p>
                                </div>
                                <ul>
                                    <li>
                                        <a href="profile.html">
                                            <i class="far fa-edit"></i> Edit Profile
                                        </a>
                                    </li>
                                    <li>
                                        <a href="setting.html">
                                            <i class="fas fa-cog"></i> Settings
                                        </a>
                                    </li>
                                    <li>
                                        <a href="login.html">
                                            <i class="fas fa-sign-out-alt"></i> logout
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <!-- Container Start -->
        <div class="page-wrapper">
            <div class="main-content">
                <div class="page-title-wrapper">
                    <div class="page-title-box splash-title-box-use">
                        <ul>
                            <li>
                                <div class="add-group">
                                    <a class="splash-btn btn btn-secondary" href="index.html">Go to Dashboard</a>
                                </div>
                            </li>
                        </ul>                  
                      </div>
                    <div class="splash-breadcrumb">
                        <ul>
                            <li>
                                <div class="add-group">
                                   <button class="splash-btn" data-bs-toggle="modal" data-bs-target="#exampleModal">Add
                                        New</button>
                                </div>
                            </li>
                        </ul>
                    </div>
                </div>
                <!-- Products view Start -->
                <div class="row">
                    <!-- Styled Table Card-->
                    <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                        <div class="card table-card">
                            <div class="card-header pb-0">
                                <a href="custom-notification-form.html">
                                    <h4>OTT </h4>
                                </a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="example" class="table table-styled" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Sl.No</th>
                                            <th>Name</th>
                                            <th>Logo</th>
                                            <th>Country</th>
                                            <th>Play Store Link</th>
                                            <th>AppStore Link</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% otts.forEach((ott, index) => { %>
                                        <tr>
                                            <td><%= index + 1 %></td>
                                            <td><%= ott.name %></td>
                                            <td><img src="<%= ott.logo || '' %>" width="40"></td>
                                            <td><%= ott.country.name %></td>
                                            <td><a href="<%= ott.playStoreLink %>" target="_blank"><%= ott.playStoreLink %></a></td>
                                            <td><a href="<%= ott.appStoreLink %>" target="_blank"><%= ott.appStoreLink %></a></td>
                                            <td>
                                                <button class="btn btn-success" onclick='editOTT("<%= JSON.stringify(ott) %>")'>Edit</button>
                                                <button class="btn btn-primary" onclick="deleteOTT('<%= ott._id %>')">Delete</button>
                                            </td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="splash-footer-btm">
                    <p>Copyright 2025 © Score Tab All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="exampleModalLabel">Add New OTT</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form class="separate-form">
                        <div class="form-group">
                            <label for="member-name" class="col-form-label"> Name*
                                </label>
                            <input class="form-control" type="text" name="name"
                                placeholder="Enter  Name*" id="ott-name">
                        </div>
                        <div class="form-group">
                            <label for="member-email" class="col-form-label">Logo </label>
                            <input class="form-control" type="file" name="logo" id="logo"
                                placeholder="Image" id="member-email">
                        </div>
                        <div class="form-group">
                            <label for="company-name" class="col-form-label"> Country </label>
                            <select name="country" id="country-select" class="form-control">
                                <option value="">Select Country</option>
                                <% countries.forEach(country => { %>
                                    <option value="<%= country._id %>"><%= country.name %></option>
                                <% }) %>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="member-name" class="col-form-label"> Play Store Link*
                                </label>
                            <input class="form-control" type="text" name="playstore"
                                placeholder="Enter  Play Store Link*" id="playstore-link">
                        </div>
                        <div class="form-group">
                            <label for="member-name" class="col-form-label"> AppStore Link*
                                </label>
                            <input class="form-control" type="text" name="appstore"
                                placeholder="Enter  AppStore Link*" id="appstore-link">
                        </div>
                        <div class="form-group mb-0">
                            <input class="btn btn-success" type="submit" value="Submit">
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Preview Setting -->
    <!-- Script Start -->
    <script src="/js/jquery.min.js"></script>
    <script src="/js/popper.min.js"></script>
    <script src="/js/datatables.min.js"></script>
    <script src="/js/dataTables.responsive.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/swiper.min.js"></script>
    <!-- Page Specific -->
    <script src="/js/nice-select.min.js"></script>
    <!-- Custom Script -->
    <script src="/js/custom.js"></script>
    <script>
        $(document).ready(function () {
            $('#example').DataTable();
        });
    </script>
    <script>
        function openForm() {
            document.getElementById("popupForm").style.display = "block";
            document.getElementById("overlay").style.display = "block";
        }

        function closeForm() {
            document.getElementById("popupForm").style.display = "none";
            document.getElementById("overlay").style.display = "none";
        }
        document.addEventListener("DOMContentLoaded", function () {
    const tableBody = document.querySelector("#example tbody");
    const form = document.querySelector(".separate-form");
    const modal = new bootstrap.Modal(document.getElementById('exampleModal'));
    let editingOTTId = null;

    // Load OTTs on page load
    async function loadOTTs() {
        const otts = await getJSON("/ott");
        tableBody.innerHTML = ""; // Clear table
        otts?.data?.data.forEach((ott, index) => {
            const row = document.createElement("tr");
            row.innerHTML = `
                <td>${index + 1}</td>
                <td>${ott.name}</td>
                <td><img src="${ott.logo || ''}" width="40"></td>
                <td>${ott.country.name}</td>
                <td><a href="${ott.playStoreLink}" target="_blank">${ott.playStoreLink}</a></td>
                <td><a href="${ott.appStoreLink}" target="_blank">${ott.appStoreLink}</a></td>
                <td>
                    <button class="btn btn-success" onclick='editOTT(${JSON.stringify(ott)})'>Edit</button>
                    <button class="btn btn-primary" onclick="deleteOTT('${ott._id}')">Delete</button>
                </td>
            `;
            tableBody.appendChild(row);
        });
    }

    // Load country options
    async function loadCountries() {
        try {
            const res = await getJSON("/country");
            const countries = res?.data?.countries || [];
            const countrySelect = document.getElementById("country-select");
            countrySelect.innerHTML = `<option value="">Select Country</option>`;
            countries.forEach(country => {
                const option = document.createElement("option");
                option.value = country._id;
                option.textContent = country.name;
                countrySelect.appendChild(option);
            });
        } catch (error) {
            console.error("Error loading countries:", error);
        }
    }

    loadOTTs();
    loadCountries();

    // Handle form submit
    form.addEventListener("submit", async function (e) {
        e.preventDefault();
        const formData = new FormData();
        const logoFile = document.getElementById("logo").files[0];

        formData.append("name", document.getElementById("ott-name").value);
        formData.append("country", document.getElementById("country-select").value);
        formData.append("playStoreLink", document.getElementById("playstore-link").value);
        formData.append("appStoreLink", document.getElementById("appstore-link").value);
        if (logoFile) formData.append("logo", logoFile);
        console.log(formData)
        try {
            if (editingOTTId) {
                
                await fetch(`https://sports-ipix.onrender.com/api/v1/ott/${editingOTTId}`, {
  method: "PATCH",
  headers: {
    Authorization: localStorage.getItem("token") || "",
  },
  body: formData,
});

            } else {
                
                const res = await fetch(`https://sports-ipix.onrender.com/api/v1/ott`, {
              method: "POST",
              headers: {
                Authorization: localStorage.getItem("token") || ""
              },
              body: formData
            });
            }
            editingOTTId = null;
            form.reset();
            modal.hide();
            loadOTTs();
        } catch (error) {
            console.error("Error submitting OTT:", error);
        }
    });

    // Edit OTT
    window.editOTT = function (ott) {
        editingOTTId = ott._id;
        document.getElementById("ott-name").value = ott.name;
        document.getElementById("country-select").value = ott.country._id;
        document.getElementById("playstore-link").value = ott.playStoreLink;
        document.getElementById("appstore-link").value = ott.appStoreLink;
        modal.show();
    };

    // Delete OTT
    window.deleteOTT = async function (id) {
        if (confirm("Are you sure you want to delete this OTT?")) {
            try {
                await deleteJSON(`/ott/${id}`);
                loadOTTs();
            } catch (error) {
                console.error("Error deleting OTT:", error);
            }
        }
    };
});
function parseJWT(token) {
        try {
          const payload = token.split(".")[1];
          const padded = payload.padEnd(
            payload.length + ((4 - (payload.length % 4)) % 4),
            "="
          );
          const base64 = padded.replace(/-/g, "+").replace(/_/g, "/");
          const decodedPayload = atob(base64);
          return JSON.parse(decodedPayload);
        } catch (error) {
          console.error("Failed to decode JWT:", error);
          return null;
        }
      }

      const bearerToken = localStorage.getItem("token")
        ? localStorage.getItem("token")
        : "hello world";
      if (bearerToken && bearerToken.startsWith("Bearer ")) {
        const jwt = bearerToken.split(" ")[1];
        const user = parseJWT(jwt);
        // ✅ Check for token expiration
        const currentTime = Math.floor(Date.now() / 1000); // in seconds

        if (user && (!user.exp || currentTime < user.exp)) {
          // Update name and role
          const nameElement = document.querySelector(".drop-down-header h4");
          const roleElement = document.querySelector(".drop-down-header p");

          if (nameElement) nameElement.innerText = user.name || "User";
          if (roleElement) roleElement.innerText = user.role || "Role";

          // ✅ Update existing profile image
          const profileImg = document.querySelector(".user-img");
          if (user.profilePic && profileImg) {
            profileImg.src = user.profilePic;
          }
        } else {
          alert("Token expired or invalid. Redirecting to login...");
          window.location.href = "/login";
        }
      } else {
        alert("No token found. Redirecting to login...");
        window.location.href = "/login";
      }
    </script>
</body>
</html>