                                </a>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table id="example" class="table table-styled" style="width:100%">
                                    <thead>
                                        <tr>
                                            <th>Sl.No</th>
                                            <th>Name</th>
                                            <th>Email</th>
                                            <th>Password</th>
                                            <th>Mobile</th>
                                            <th>Action</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% const admins = [
                                            { id: 1, name: "Srinivas", email: "srinivas@scoretab.in", password: "xyz", mobile: "" },
                                            { id: 2, name: "Jhon", email: "abc@scoretab.in", password: "abc", mobile: "" }
                                        ]; %>
                                        <% admins.forEach((admin, index) => { %>
                                            <tr>
                                                <td><%= index + 1 %></td>
                                                <td><%= admin.name %></td>
                                                <td><%= admin.email %></td>
                                                <td><%= admin.password %></td>
                                                <td><%= admin.mobile %></td>
                                                <td>
                                                    <a href="" class="btn btn-success">Edit</a>
                                                    <a href="" class="btn btn-primary">Delete</a>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    </tbody>
                                </table>
                            </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="splash-footer-btm">
                    <p>Copyright 2025 © Score Tab All Rights Reserved.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
