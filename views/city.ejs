<!DOCTYPE html>
<html lang="zxx">
  <head>
    <title><%= title || "Score Tab" %></title>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta name="description" content="" />
    <meta name="keywords" content="" />
    <meta name="author" content="" />
    <meta name="MobileOptimized" content="320" />
    <link rel="stylesheet" type="text/css" href="/css/fonts.css" />
    <link rel="stylesheet" type="text/css" href="/css/datatables.css" />
    <link rel="stylesheet" type="text/css" href="/css/bootstrap.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/font-awesome.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/icofont.min.css" />
    <link rel="stylesheet" href="/css/swiper.min.css" />
    <link rel="stylesheet" type="text/css" href="/css/nice-select.css" />
    <link rel="stylesheet" type="text/css" href="/css/style.css" />
    <link rel="stylesheet" id="theme-change" type="text/css" href="#" />
    <link rel="shortcut icon" type="image/png" href="/images/favicon.png" />
    <script src="/js/jquery.min.js"></script>
    <script src="/js/bootstrap.min.js"></script>
    <script src="/js/api.js"></script>
  </head>
  <body>
    <div class="loader">
      <div class="spinner">
        <img src="/images/loader.gif" alt="" />
      </div>
    </div>
    <div class="page-wrapper">
      <header class="header-wrapper main-header">
        <div class="header-inner-wrapper">
          <div class="header-right">
            <div class="header-left">
              <div class="header-links">
                <a href="/" class="admin-logo">
                  <img src="/logo.svg" alt="" class="sp_logo w-100" />
                  <img src="/logo.svg" alt="" class="sp_mini_logo w-100" />
                </a>
              </div>
            </div>
            <div class="header-controls">
              <div class="user-info-wrapper header-links">
                <a href="javascript:void(0);" class="user-info">
                  <img src="/images/user.jpg" alt="" class="user-img" />
                  <div class="blink-animation">
                    <span class="blink-circle"></span>
                    <span class="main-circle"></span>
                  </div>
                </a>
                <div class="user-info-box">
                  <div class="drop-down-header">
                    <h4><%= user?.name || "John Brown" %></h4>
                    <p><%= user?.role || "UI | UX Designer" %></p>
                  </div>
                  <ul>
                    <li>
                      <a href="/profile"
                        ><i class="far fa-edit"></i> Edit Profile</a
                      >
                    </li>
                    <li>
                      <a href="/setting"><i class="fas fa-cog"></i> Settings</a>
                    </li>
                    <li>
                      <a href="/login"
                        ><i class="fas fa-sign-out-alt"></i> Logout</a
                      >
                    </li>
                  </ul>
                </div>
              </div>
            </div>
          </div>
        </div>
      </header>

      <div class="page-wrapper">
        <div class="main-content">
          <div class="page-title-wrapper">
            <div class="page-title-box splash-title-box-use">
              <ul>
                <li>
                  <div class="add-group">
                    <a class="splash-btn btn btn-secondary" href="/"
                      >Go to Dashboard</a
                    >
                  </div>
                </li>
              </ul>
            </div>
            <div class="splash-breadcrumb">
              <ul>
                <li>
                  <div class="add-group">
                    <button
                      class="splash-btn"
                      data-bs-toggle="modal"
                      data-bs-target="#exampleModal"
                    >
                      Add New
                    </button>
                  </div>
                </li>
              </ul>
            </div>
          </div>

          <div class="row">
            <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
              <div class="card table-card">
                <div class="card-header pb-0">
                  <a href="custom-notification-form.html"><h4>City</h4></a>
                </div>
                <div class="card-body">
                  <div class="table-responsive">
                    <table
                      id="example"
                      class="table table-styled"
                      style="width: 100%"
                    >
                      <thead>
                        <tr>
                          <th>Sl.No</th>
                          <th>City</th>
                          <th>Country</th>
                          <th>Action</th>
                        </tr>
                      </thead>
                      <tbody>
                        <% cities?.forEach((city, index) => { %>
                        <tr>
                          <td><%= index + 1 %></td>
                          <td><%= city.name %></td>
                          <td><%= city.country?.name || "N/A" %></td>
                          <td>
                            <a
                              class="btn btn-success"
                              onclick="editCity('<%= city._id %>', '<%= city.name %>')"
                              >Edit</a
                            >
                            <a
                              class="btn btn-primary"
                              onclick="deleteCity('<%= city._id %>')"
                              >Delete</a
                            >
                          </td>
                        </tr>
                        <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="splash-footer-btm">
            <p>Copyright 2025 © Score Tab All Rights Reserved.</p>
          </div>
        </div>
      </div>
    </div>

    <div
      class="modal fade"
      id="exampleModal"
      tabindex="-1"
      aria-labelledby="exampleModalLabel"
      aria-hidden="true"
    >
      <div class="modal-dialog">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title" id="exampleModalLabel">Add New City</h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
              aria-label="Close"
            ></button>
          </div>
          <div class="modal-body">
            <form class="separate-form" id="city-form">
              <input type="hidden" id="city-id" />
              <div class="form-group">
                <label for="member-name" class="col-form-label"
                  >City Name*</label
                >
                <input
                  class="form-control"
                  type="text"
                  placeholder="Enter City Name*"
                  id="member-name"
                />
              </div>
              <div class="form-group">
                <label for="country-select" class="col-form-label"
                  >Country</label
                >
                <select id="country-select" class="form-control">
                  <option value="0">Select Country</option>
                  <% countries?.forEach((country) => { %>
                  <option value="<%= country._id %>">
                    <%= country.name %>
                  </option>
                  <% }) %>
                </select>
              </div>
              <div class="form-group mb-0">
                <input class="btn btn-success" type="submit" value="Submit" />
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>

    <div id="overlay" class="overlay" onclick="closeForm()"></div>
    <div class="popup-form" id="popupForm">
      <button class="close-btn" id="overlay" onclick="closeForm()">X</button>
      <h4>Add New Country</h4>
      <div class="card-body"></div>
    </div>

    <script src="/js/popper.min.js"></script>
    <script src="/js/datatables.min.js"></script>
    <script src="/js/dataTables.responsive.min.js"></script>
    <script src="/js/swiper.min.js"></script>
    <script src="/js/nice-select.min.js"></script>
    <script src="/js/custom.js"></script>

    <script>
      $(document).ready(function () {
        $("#example").DataTable();
      });

      function openForm() {
        document.getElementById("popupForm").style.display = "block";
        document.getElementById("overlay").style.display = "block";
      }

      function closeForm() {
        document.getElementById("popupForm").style.display = "none";
        document.getElementById("overlay").style.display = "none";
      }
    </script>

    <script>
      async function loadCountries() {
        try {
          const data = await getJSON("/country");
          if (data.success) {
            const select = document.querySelector("select.form-control");
            select.innerHTML = '<option value="0">Select Country</option>'; // Reset

            data.data.countries.forEach((country) => {
              const option = document.createElement("option");
              option.value = country._id;
              option.textContent = country.name;
              select.appendChild(option);
            });
          } else {
            alert("Failed to load countries");
          }
        } catch (err) {
          console.error("Error fetching countries:", err);
        }
      }
      loadCountries(); // Call the function to load countries on page load
      async function fetchCities() {
        try {
          const response = await getJSON("/city"); // Assuming the API route is /city
          const data = (await response.json) ? await response.json() : response;
          if (data.success && Array.isArray(data.data.cities)) {
            const tbody = document.querySelector("#example tbody");
            tbody.innerHTML = ""; // Clear existing rows

            data.data.cities.forEach((city, index) => {
              const row = document.createElement("tr");
              row.innerHTML = `
                <td>${index + 1}</td>
                <td>${city.name}</td>
                <td>${city.country?.name || "N/A"}</td>
                <td>
                    <a class="btn btn-success" onclick="editCity('${city._id}')">Edit</a>
                    <a class="btn btn-primary" onclick="deleteCity('${city._id}')">Delete</a>
                </td>
                `;

              tbody.appendChild(row);
            });
          } else {
            alert("Failed to load cities.");
          }
        } catch (error) {
          console.error("Error loading cities:", error);
        }
      }
      async function editCity(id) {
        try {
          const city = await getJSON(`/city/${id}`);
          if (city.success && city.data) {
            document.getElementById("city-id").value = city.data._id;
            document.getElementById("member-name").value = city.data.name;
            document.getElementById("country-select").value =
              city.data.country?._id || "0";

            const modal = new bootstrap.Modal(
              document.getElementById("exampleModal")
            );
            modal.show();
          } else {
            alert("Failed to load city data");
          }
        } catch (err) {
          console.error("Error loading city:", err);
          alert("Something went wrong");
        }
      }

      function deleteCity(id) {
        if (confirm("Are you sure you want to delete this city?")) {
          deleteJSON(`/city/${id}`)
            .then(() => {
              alert("City deleted!");
              fetchCities();
            })
            .catch((err) => {
              console.error("Error deleting city:", err);
              alert("Failed to delete city.");
            });
        }
      }

      document.addEventListener("DOMContentLoaded", fetchCities);
    </script>
    <script>
      document
        .querySelector("#city-form")
        .addEventListener("submit", async function (e) {
          e.preventDefault();

          const cityName = document.querySelector("#member-name").value.trim();
          const countryId = document.querySelector("#country-select").value;
          const cityId = document.querySelector("#city-id").value;
          console.log(countryId);

          if (!cityName || countryId === "0") {
            alert("Please fill all fields");
            return;
          }

          try {
            let response;
            if (cityId) {
              response = await patchJSON(`/city/${cityId}`, {
                name: cityName,
                country: countryId,
              });
            } else {
              response = await postJSON("/city", {
                name: cityName,
                country: countryId,
              });
            }
            if (response.success) {
              
              fetchCities();
              document.querySelector("#city-form").reset();
              document.getElementById("city-id").value = "";
              document.querySelector(".btn-close").click();
            } else {
              alert(data.message || "Error saving city");
            }
          } catch (err) {
            console.error("Save error:", err);
          }
        });

      function parseJWT(token) {
        try {
          const payload = token.split(".")[1];
          const padded = payload.padEnd(
            payload.length + ((4 - (payload.length % 4)) % 4),
            "="
          );
          const base64 = padded.replace(/-/g, "+").replace(/_/g, "/");
          const decodedPayload = atob(base64);
          return JSON.parse(decodedPayload);
        } catch (error) {
          console.error("Failed to decode JWT:", error);
          return null;
        }
      }

      const bearerToken = localStorage.getItem("token")
        ? localStorage.getItem("token")
        : "hello world";
      if (bearerToken && bearerToken.startsWith("Bearer ")) {
        const jwt = bearerToken.split(" ")[1];
        const user = parseJWT(jwt);
        // ✅ Check for token expiration
        const currentTime = Math.floor(Date.now() / 1000); // in seconds

        if (user && (!user.exp || currentTime < user.exp)) {
          // Update name and role
          const nameElement = document.querySelector(".drop-down-header h4");
          const roleElement = document.querySelector(".drop-down-header p");

          if (nameElement) nameElement.innerText = user.name || "User";
          if (roleElement) roleElement.innerText = user.role || "Role";

          // ✅ Update existing profile image
          const profileImg = document.querySelector(".user-img");
          if (user.profilePic && profileImg) {
            profileImg.src = user.profilePic;
          }
        } else {
          alert("Token expired or invalid. Redirecting to login...");
          window.location.href = "/login";
        }
      } else {
        alert("No token found. Redirecting to login...");
        window.location.href = "/login";
      }
    </script>
  </body>
</html>
