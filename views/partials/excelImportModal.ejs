<!-- Modal: Excel Import -->
<div
  class="modal fade"
  id="exampleModalexcel"
  tabindex="-1"
  aria-labelledby="exampleModalLabelexcel"
  aria-hidden="true"
>
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="exampleModalLabelexcel">Excel Import</h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>
      <div class="modal-body">
        <form class="separate-form" id="venueFormexcel">
          <div class="form-group">
            <label for="excelFile" class="col-form-label">Excel File</label>
            <input
              class="form-control"
              type="file"
              id="excelFile"
              accept=".xlsx, .xls"
            />
          </div>

          <div class="form-group mb-0">
            <input
              class="btn btn-success"
              type="button"
              value="Submit"
              id="uploadBtn"
            />
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

