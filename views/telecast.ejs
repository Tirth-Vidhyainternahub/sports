<!DOCTYPE html>
<html lang="zxx">
    <meta http-equiv="content-type" content="text/html;charset=UTF-8" />
    <head>
        <title>Score Tab</title>
        <meta charset="utf-8" />
        <meta content="width=device-width, initial-scale=1.0" name="viewport" />
        <meta name="description" content="" />
        <meta name="keywords" content="" />
        <meta name="author" content="" />
        <meta name="MobileOptimized" content="320" />
        <!--Start Style -->
        <link rel="stylesheet" type="text/css" href="/css/fonts.css" />
        <link rel="stylesheet" type="text/css" href="/css/datatables.css" />
        <link
            rel="stylesheet"
            type="text/css"
            href="/css/bootstrap.min.css"
        />
        <link
            rel="stylesheet"
            type="text/css"
            href="/css/font-awesome.min.css"
        />
        <link rel="stylesheet" type="text/css" href="/css/icofont.min.css" />
        <link rel="stylesheet" href="/css/swiper.min.css" />
        <!--Page Specific -->
        <link rel="stylesheet" type="text/css" href="/css/nice-select.css" />
        <!--Custom Style -->
        <link rel="stylesheet" type="text/css" href="/css/style.css" />
        <link rel="stylesheet" id="theme-change" type="text/css" href="#" />
        <!-- Favicon Link -->
        <link
            rel="shortcut icon"
            type="image/png"
            href="/images/favicon.png"
        />
        <script src="/js/jquery.min.js"></script>
        <script src="/js/bootstrap.min.js"></script>
        <script src="/js/api.js"></script>
    </head>
    <body>
        <div class="loader">
            <div class="spinner">
                <img src="/images/loader.gif" alt="" />
            </div>
        </div>
        <!-- Main Body -->
        <div class="page-wrapper">
            <!-- Header Start -->
            <header class="header-wrapper main-header">
                <div class="header-inner-wrapper">
                    <div class="header-right">
                        <div class="header-left">
                            <div class="header-links">
                                <a href="/" class="admin-logo">
                                    <img src="/logo.svg" alt="" class="sp_logo w-100" />
                                    <img
                                        src="/logo.svg"
                                        alt=""
                                        class="sp_mini_logo w-100"
                                    />
                                </a>
                            </div>
                        </div>
                        <div class="header-controls">
                            <div class="user-info-wrapper header-links">
                                <a href="javascript:void(0);" class="user-info">
                                    <img src="/images/user.jpg" alt="" class="user-img" />
                                    <div class="blink-animation">
                                        <span class="blink-circle"></span>
                                        <span class="main-circle"></span>
                                    </div>
                                </a>
                                <div class="user-info-box">
                                    <div class="drop-down-header">
                                        <h4>John Brown</h4>
                                        <p>UI | UX Designer</p>
                                    </div>
                                    <ul>
                                        <li>
                                            <a href="/profile">
                                                <i class="far fa-edit"></i> Edit Profile
                                            </a>
                                        </li>
                                        <li>
                                            <a href="/setting">
                                                <i class="fas fa-cog"></i> Settings
                                            </a>
                                        </li>
                                        <li>
                                            <a href="/login">
                                                <i class="fas fa-sign-out-alt"></i> logout
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Container Start -->
            <div class="page-wrapper">
                <div class="main-content">
                    <div class="page-title-wrapper">
                        <div class="page-title-box splash-title-box-use">
                            <ul>
                                <li>
                                    <div class="add-group">
                                        <a class="splash-btn btn btn-secondary" href="/"
                                            >Go to Dashboard</a
                                        >
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="splash-breadcrumb">
                            <ul>
                                <li>
                                    <div class="add-group">
                                        <button
                                            class="splash-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#exampleModal"
                                        >
                                            Add New
                                        </button>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                    <!-- Products view Start -->
                    <div class="row">
                        <!-- Styled Table Card-->
                        <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 col-12">
                            <div class="card table-card">
                                <div class="card-header pb-0">
                                    <a href="/custom-notification-form">
                                        <h4>Telecast</h4>
                                    </a>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table
                                            id="example"
                                            class="table table-styled"
                                            style="width: 100%"
                                        >
                                            <thead>
                                                <tr>
                                                    <th>Sl.No</th>
                                                    <th>Name</th>
                                                    <th>Logo</th>
                                                    <th>Country</th>
                                                    <th>Link</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% telecasts.forEach((telecast, index) => { %>
                                                <tr>
                                                    <td><%= index + 1 %></td>
                                                    <td><%= telecast.name %></td>
                                                    <td>
                                                        <% if (telecast.logo) { %>
                                                        <img src="<%= telecast.logo %>" width="40" />
                                                        <% } %>
                                                    </td>
                                                    <td><%= telecast.country?.name || '' %></td>
                                                    <td>
                                                        <a href="<%= telecast.link %>" target="_blank">
                                                            <%= telecast.link %>
                                                        </a>
                                                    </td>
                                                    <td>
                                                        <a
                                                            href="javascript:void(0);"
                                                            class="btn btn-success"
                                                            onclick='editTelecast("<%= JSON.stringify(telecast) %>")'
                                                            >Edit</a
                                                        >
                                                        <a
                                                            href="javascript:void(0);"
                                                            class="btn btn-primary"
                                                            onclick='deleteTelecast("<%= telecast._id %>")'
                                                            >Delete</a
                                                        >
                                                    </td>
                                                </tr>
                                                <% }); %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="splash-footer-btm">
                        <p>Copyright 2025 © Score Tab All Rights Reserved.</p>
                    </div>
                </div>
            </div>
        </div>

        <div
            class="modal fade"
            id="exampleModal"
            tabindex="-1"
            aria-labelledby="exampleModalLabel"
            aria-hidden="true"
        >
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="exampleModalLabel">Add New Telecast</h5>
                        <button
                            type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close"
                        ></button>
                    </div>
                    <div class="modal-body">
                        <form class="separate-form">
                            <div class="form-group">
                                <label for="member-name" class="col-form-label"> Name* </label>
                                <input
                                    class="form-control"
                                    type="text"
                                    placeholder="Enter  Name*"
                                    id="telecast-name"
                                />
                            </div>
                            <div class="form-group">
                                <label for="member-email" class="col-form-label">Logo </label>
                                <input
                                    class="form-control"
                                    type="file"
                                    placeholder="Image"
                                    id="logo"
                                />
                            </div>
                            <div class="form-group">
                                <label for="company-name" class="col-form-label">
                                    Country
                                </label>
                                <select name="country" id="country" class="form-control">
                                    <option value="">Select Country</option>
                                    <% countries.forEach((country) => { %>
                                    <option value="<%= country._id %>"><%= country.name %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="form-group">
                                <label for="member-name" class="col-form-label">Link* </label>
                                <input
                                    class="form-control"
                                    type="text"
                                    placeholder="Enter Link*"
                                    id="Link"
                                />
                            </div>
                            <div class="form-group mb-0">
                                <input class="btn btn-success" type="submit" value="Submit" />
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Preview Setting -->
        <!-- Script Start -->
        <script src="/js/jquery.min.js"></script>
        <script src="/js/popper.min.js"></script>
        <script src="/js/datatables.min.js"></script>
        <script src="/js/dataTables.responsive.min.js"></script>
        <script src="/js/bootstrap.min.js"></script>
        <script src="/js/swiper.min.js"></script>
        <!-- Page Specific -->
        <script src="/js/nice-select.min.js"></script>
        <!-- Custom Script -->
        <script src="/js/custom.js"></script>
        <script>
            $(document).ready(function () {
                $("#example").DataTable();
            });
        </script>

        <script>
            function openForm() {
                document.getElementById("popupForm").style.display = "block";
                document.getElementById("overlay").style.display = "block";
            }

            function closeForm() {
                document.getElementById("popupForm").style.display = "none";
                document.getElementById("overlay").style.display = "none";
            }
        </script>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const tableBody = document.querySelector("#example tbody");
                const form = document.querySelector(".separate-form");
                const modal = new bootstrap.Modal(
                    document.getElementById("exampleModal")
                );
                let editingTelecastId = null;

                // Load Telecasts
                async function loadTelecasts() {
                    try {
                        const res = await getJSON("/telecast");
                        const telecasts = res?.data?.data || [];
                        tableBody.innerHTML = "";
                        telecasts.forEach((telecast, index) => {
                            const row = document.createElement("tr");
                            row.innerHTML = `
                    <td>${index + 1}</td>
                    <td>${telecast.name}</td>
                    <td><img src="${telecast.logo || ""}" width="40" /></td>
                    <td>${telecast.country?.name || ""}</td>
                    <td><a href="${telecast.link}" target="_blank">${
                                telecast.link
                            }</a></td>
                    <td>
                        <a class="btn btn-success" onclick='editTelecast(${JSON.stringify(
                            telecast
                        )})'>Edit</a>
                        <a class="btn btn-primary" onclick='deleteTelecast("${
                            telecast._id
                        }")'>Delete</a>
                    </td>
                `;
                            tableBody.appendChild(row);
                        });
                    } catch (err) {
                        console.error("Error loading telecasts:", err);
                    }
                }

                // Load Countries
                async function loadCountries() {
                    try {
                        const res = await getJSON("/country");
                        const countries = res?.data?.countries || [];
                        const select = document.getElementById("country");
                        select.innerHTML = `<option value="">Select Country</option>`;
                        countries.forEach((country) => {
                            const option = document.createElement("option");
                            option.value = country._id;
                            option.textContent = country.name;
                            select.appendChild(option);
                        });
                    } catch (err) {
                        console.error("Error loading countries:", err);
                    }
                }

                loadCountries();
                loadTelecasts();

                // Handle Form Submit
                form.addEventListener("submit", async function (e) {
                    e.preventDefault();
                    const formData = new FormData();
                    const name = document.getElementById("telecast-name").value;
                    const country = document.getElementById("country").value;
                    const link = document.getElementById("Link").value;
                    const logoFile = document.getElementById("logo").files[0];

                    formData.append("name", name);
                    formData.append("country", country);
                    formData.append("link", link);
                    if (logoFile) formData.append("logo", logoFile);
                    

                    try {
                        if (editingTelecastId) {
                            await fetch(
                                `https://sports-ipix.onrender.com/api/v1/telecast/${editingTelecastId}`,
                                {
                                    method: "PUT",
                                    headers: {
                                        Authorization: localStorage.getItem("token") || "",
                                    },
                                    body: formData,
                                }
                            );
                        } else {
                            const res = await fetch(
                                `https://sports-ipix.onrender.com/api/v1/telecast`,
                                {
                                    method: "POST",
                                    headers: {
                                        Authorization: localStorage.getItem("token") || "",
                                    },
                                    body: formData,
                                }
                            );
                        }
                        editingTelecastId = null;
                        form.reset();
                        modal.hide();
                        loadTelecasts();
                    } catch (err) {
                        console.error("Error saving telecast:", err);
                    }
                });

                // Edit Telecast
                window.editTelecast = function (telecast) {
                    editingTelecastId = telecast._id;
                    document.getElementById("telecast-name").value = telecast.name;
                    document.getElementById("country").value =
                        telecast.country?._id || "";
                    document.getElementById("Link").value = telecast.link;
                    modal.show();
                };

                // Delete Telecast
                window.deleteTelecast = async function (id) {
                    if (confirm("Are you sure you want to delete this telecast?")) {
                        try {
                            await deleteJSON(`/telecast/${id}`);
                            loadTelecasts();
                        } catch (err) {
                            console.error("Error deleting telecast:", err);
                        }
                    }
                };
            });
            function parseJWT(token) {
        try {
          const payload = token.split(".")[1];
          const padded = payload.padEnd(
            payload.length + ((4 - (payload.length % 4)) % 4),
            "="
          );
          const base64 = padded.replace(/-/g, "+").replace(/_/g, "/");
          const decodedPayload = atob(base64);
          return JSON.parse(decodedPayload);
        } catch (error) {
          console.error("Failed to decode JWT:", error);
          return null;
        }
      }

      const bearerToken = localStorage.getItem("token")
        ? localStorage.getItem("token")
        : "hello world";
      if (bearerToken && bearerToken.startsWith("Bearer ")) {
        const jwt = bearerToken.split(" ")[1];
        const user = parseJWT(jwt);
        // ✅ Check for token expiration
        const currentTime = Math.floor(Date.now() / 1000); // in seconds

        if (user && (!user.exp || currentTime < user.exp)) {
          // Update name and role
          const nameElement = document.querySelector(".drop-down-header h4");
          const roleElement = document.querySelector(".drop-down-header p");

          if (nameElement) nameElement.innerText = user.name || "User";
          if (roleElement) roleElement.innerText = user.role || "Role";

          // ✅ Update existing profile image
          const profileImg = document.querySelector(".user-img");
          if (user.profilePic && profileImg) {
            profileImg.src = user.profilePic;
          }
        } else {
          alert("Token expired or invalid. Redirecting to login...");
          window.location.href = "/login";
        }
      } else {
        alert("No token found. Redirecting to login...");
        window.location.href = "/login";
      }
        </script>
    </body>
</html>