        <script src="/js/jquery.min.js"></script>
        <script src="/js/popper.min.js"></script>
        <script src="/js/datatables.min.js"></script>
        <script src="/js/dataTables.responsive.min.js"></script>
        <script src="/js/bootstrap.min.js"></script>
        <script src="/js/swiper.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.17.0/xlsx.full.min.js"></script>
        <script src="/js/nice-select.min.js"></script>
        <script src="/js/custom.js"></script>
        <script>
            $(document).ready(function () {
                $("#example").DataTable();
            });
            document.addEventListener("DOMContentLoaded", () => {
          const cityMap = new Map();
          const countryMap = new Map();
        const venueTableBody = document.querySelector("#example tbody");
        const addBtn = document.querySelector("#addVenueBtn");
        const form = document.querySelector("#exampleModal #venueForm");
        const modal = new bootstrap.Modal(
          document.getElementById("exampleModal")
        );
        const uploadBtn = document.querySelector(
          "#exampleModalexcel #uploadBtn"
        );

        // Load venues on page load
        loadVenues();

        // Load form for add
        addBtn.addEventListener("click", async () => {
          await loadCityAndCountryOptions();
          form.reset();
          form.setAttribute("data-id", "");
          modal.show();
        });

        // Submit form (add or update)
        form.addEventListener("submit", async (e) => {
          e.preventDefault();
          const id = form.getAttribute("data-id");
          const formData = new FormData(form);
          const data = {
            name: formData.get("name"),
            geolocation: formData.get("geoLocation"),
            lat: formData.get("lat"),
            long: formData.get("long"),
            city: formData.get("city"),
            country: formData.get("country"),
          };

          if (id) {
            await putJSON(`/venue/${id}`, data);
          } else {
            await postJSON("/venue", data);
          }

          modal.hide();
          loadVenues();
        });

        // Load venues
        async function loadVenues() {
          const venues = await getJSON("/venue");
          venueTableBody.innerHTML = "";

          venues?.data?.venues?.forEach((v, index) => {
            const row = document.createElement("tr");
            row.innerHTML = `
        <td>${index + 1}</td>
        <td>${v.name}</td>
        <td><a href="${v.location.geolocation}" target="_blank">${
              v.location.geolocation
            }</a></td>
        <td>${v.location.lat}</td>
        <td>${v.location.long}</td>
        <td>${v.city.name}</td>
        <td>${v.country.name}</td>
        <td>
          <a class="btn btn-success btn-sm edit-btn" data-id="${v._id}">Edit</a>
          <a class="btn btn-primary btn-sm delete-btn" data-id="${
            v._id
          }">Delete</a>
        </td>
      `;
            venueTableBody.appendChild(row);
          });

          // Attach events for Edit/Delete
          document.querySelectorAll(".edit-btn").forEach((btn) => {
            btn.addEventListener("click", () =>
              openEditModal(btn.getAttribute("data-id"))
            );
          });

          document.querySelectorAll(".delete-btn").forEach((btn) => {
            btn.addEventListener("click", async () => {
              if (confirm("Are you sure to delete this venue?")) {
                await deleteJSON(`/venue/${btn.getAttribute("data-id")}`);
                loadVenues();
              }
            });
          });
        }

        // Load city and country options
        async function loadCityAndCountryOptions() {
          const citySelect = form.querySelector("select[name='city']");
          const countrySelect = form.querySelector("select[name='country']");
          citySelect.innerHTML = `<option value="">Select City</option>`;
          countrySelect.innerHTML = `<option value="">Select Country</option>`;

          const [cities, countries] = await Promise.all([
            getJSON("/city"),
            getJSON("/country"),
          ]);
          cities?.data?.cities?.forEach((c) => cityMap.set(c.name, c._id));

         
          countries?.data?.countries?.forEach((c) =>
            countryMap.set(c.name, c._id)
          );
          cities?.data?.cities.forEach((city) => {
            const option = document.createElement("option");
            option.value = city._id;
            option.textContent = city.name;
            citySelect.appendChild(option);
          });
          countries?.data?.countries.forEach((country) => {
            const option = document.createElement("option");
            option.value = country._id;
            option.textContent = country.name;
            countrySelect.appendChild(option);
          });
        }
         loadCityAndCountryOptions();
        // Open edit modal and load data
        async function openEditModal(id) {
          const venue = await getJSON(`/venue/${id}`);
          const v = venue.data;
          console.log(v);

          await loadCityAndCountryOptions();

          form.setAttribute("data-id", id);
          form.querySelector('input[placeholder="Enter  Name*"]').value =
            v.name;
          form.querySelector(
            'input[placeholder="Enter  Geo Location*"]'
          ).value = v.location.geolocation;
          form.querySelector('input[placeholder="Enter  Lat*"]').value =
            v.location.lat;
          form.querySelector('input[placeholder="Enter  Long*"]').value =
            v.location.long;
          form.querySelector('select[name="country"]').value = v.country._id;
          form.querySelector('select[name="city"]').value = v.city._id;

          modal.show();
        }
        
      
        function parseJWT(token) {
        try {
          const payload = token.split(".")[1];
          const padded = payload.padEnd(
            payload.length + ((4 - (payload.length % 4)) % 4),
            "="
          );
          const base64 = padded.replace(/-/g, "+").replace(/_/g, "/");
          const decodedPayload = atob(base64);
          return JSON.parse(decodedPayload);
        } catch (error) {
          console.error("Failed to decode JWT:", error);
          return null;
        }
      }

      const bearerToken = localStorage.getItem("token")
        ? localStorage.getItem("token")
        : "hello world";
      if (bearerToken && bearerToken.startsWith("Bearer ")) {
        const jwt = bearerToken.split(" ")[1];
        const user = parseJWT(jwt);
        // ✅ Check for token expiration
        const currentTime = Math.floor(Date.now() / 1000); // in seconds

        if (user && (!user.exp || currentTime < user.exp)) {
          // Update name and role
          const nameElement = document.querySelector(".drop-down-header h4");
          const roleElement = document.querySelector(".drop-down-header p");

          if (nameElement) nameElement.innerText = user.name || "User";
          if (roleElement) roleElement.innerText = user.role || "Role";

          // ✅ Update existing profile image
          const profileImg = document.querySelector(".user-img");
          if (user.profilePic && profileImg) {
            profileImg.src = user.profilePic;
          }
        } else {
          alert("Token expired or invalid. Redirecting to login...");
          window.location.href = "/login";
        }
      } else {
        alert("No token found. Redirecting to login...");
        window.location.href = "/login";
      }
      document.getElementById("uploadBtn").addEventListener("click", async () => {
    const fileInput = document.getElementById("excelFile");
    const file = fileInput.files[0];

    if (!file) {
      alert("Please select an Excel file.");
      return;
    }
    const reader = new FileReader();
    reader.onload = async (e) => {
      const data = new Uint8Array(e.target.result);
      const workbook = XLSX.read(data, { type: "array" });
      const firstSheetName = workbook.SheetNames[0];
      const worksheet = workbook.Sheets[firstSheetName];
      const jsonData = XLSX.utils.sheet_to_json(worksheet);

      for (const row of jsonData) {
        console.log(row)
        const venueData = {
          name: row.name,
          geolocation: row.geolocation,
          lat: row.lat,
          long: row.long,
          city: cityMap.get(row.city),
    country: countryMap.get(row.country),
        };

        try {
          await postJSON("/venue", venueData);
        } catch (err) {
          console.error("Error uploading venue:", err);
        }
      }

      // Reload venue list after import
      if (typeof loadVenues === "function") loadVenues();
      document.getElementById("exampleModalexcel").querySelector(".btn-close").click();
    };

    reader.readAsArrayBuffer(file);
  });

  //Using Bulkupload Api
