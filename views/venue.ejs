                                    </a>
                                </div>
                                <div class="card-body">
                                    <div class="table-responsive">
                                        <table id="example" class="table table-styled" style="width: 100%">
                                            <thead>
                                                <tr>
                                                    <th>Sl.No</th>
                                                    <th>Name</th>
                                                    <th>Geo Location</th>
                                                    <th>Lat</th>
                                                    <th>Long</th>
                                                    <th>City</th>
                                                    <th>Country</th>
                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% venues.forEach((venue, index) => { %>
                                                <tr>
                                                    <td><%= index + 1 %></td>
                                                    <td><%= venue.name %></td>
                                                    <td><a href="<%= venue.location.geolocation %>" target="_blank"><%= venue.location.geolocation %></a></td>
                                                    <td><%= venue.location.lat %></td>
                                                    <td><%= venue.location.long %></td>
                                                    <td><%= venue.city.name %></td>
                                                    <td><%= venue.country.name %></td>
                                                    <td>
                                                        <a href="#" class="btn btn-success edit-btn" data-id="<%= venue._id %>">Edit</a>
                                                        <a href="#" class="btn btn-primary delete-btn" data-id="<%= venue._id %>">Delete</a>
